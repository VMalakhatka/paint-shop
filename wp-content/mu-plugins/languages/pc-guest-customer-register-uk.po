msgid "Your account has been created using the email entered at checkout."
msgstr "Для вас створено кабінет за e-mail, вказаним під час оформлення."

msgid "This order is linked to the account for the email entered at checkout. Sign in to view your orders."
msgstr "Це замовлення прив’язано до кабінету за e-mail, вказаним під час оформлення. Увійдіть, щоб переглянути свої замовлення."

msgid "Check your email for the password setup link, including your spam folder."
msgstr "Перевірте пошту, зокрема папку «Спам»: у листі є посилання для встановлення пароля."

msgid "The password setup email could not be sent. Use password recovery to access your account."
msgstr "Не вдалося надіслати лист для встановлення пароля. Скористайтеся відновленням пароля для входу до кабінету."

msgid "My account"
msgstr "Мій кабінет"

msgid "Set or recover password"
msgstr "Встановити або відновити пароль"
