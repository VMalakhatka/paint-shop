msgid "Your account has been created using the email entered at checkout."
msgstr "Для вас создан кабинет по e-mail, указанному при оформлении."

msgid "This order is linked to the account for the email entered at checkout. Sign in to view your orders."
msgstr "Этот заказ привязан к кабинету по e-mail, указанному при оформлении. Войдите, чтобы просмотреть свои заказы."

msgid "Check your email for the password setup link, including your spam folder."
msgstr "Проверьте почту, включая папку «Спам»: в письме есть ссылка для установки пароля."

msgid "The password setup email could not be sent. Use password recovery to access your account."
msgstr "Не удалось отправить письмо для установки пароля. Воспользуйтесь восстановлением пароля для входа в кабинет."

msgid "My account"
msgstr "Мой кабинет"

msgid "Set or recover password"
msgstr "Установить или восстановить пароль"
