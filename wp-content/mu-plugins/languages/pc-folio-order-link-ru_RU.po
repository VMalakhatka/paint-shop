#: pc-folio-order-link.php:174
msgid "These fields only store the Woo order to Folio document connection. They do not send anything to Folio."
msgstr ""
"Эти поля только сохраняют связь заказа Woo с документом ФОЛИО. Они ничего "
"не отправляют в ФОЛИО."

msgid "Split status"
msgstr "Статус разделения"

msgid "not set"
msgstr "не задан"

msgid "Saved Folio documents"
msgstr "Сохранённые документы ФОЛИО"

msgid "missing stock"
msgstr "нехватка товара"

msgid "account"
msgstr "счёт"

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d позиция"
msgstr[1] "%d позиции"
msgstr[2] "%d позиций"

msgid "Kind: %s"
msgstr "Тип: %s"

msgid "Future Woo child order items"
msgstr "Позиции будущего дочернего заказа Woo"

msgid "without SKU"
msgstr "без SKU"

msgid "price"
msgstr "цена"

msgid "amount"
msgstr "сумма"

msgid "No items in this Folio document."
msgstr "В этом документе ФОЛИО нет позиций."

msgid "No saved Folio documents yet."
msgstr "Сохранённых документов ФОЛИО пока нет."

msgid "Linked Woo child orders"
msgstr "Связанные дочерние заказы Woo"

msgid "No linked Woo child orders yet."
msgstr "Связанных дочерних заказов Woo пока нет."

#: pc-folio-order-link.php:236
#: pc-folio-order-link.php:246
msgid "Folio JSON preview"
msgstr "Предпросмотр JSON ФОЛИО"

#: pc-folio-order-link.php:291
msgid "Preview only. This JSON is not sent to Folio yet."
msgstr "Только предпросмотр. Этот JSON пока не отправляется в ФОЛИО."

msgid "Send preview to Java"
msgstr "Отправить preview в Java"

msgid "Create Folio account(s)"
msgstr "Создать счёт(а) ФОЛИО"

msgid "Java Base URL is not configured."
msgstr "Java Base URL не настроен."

msgid "Java response simulator"
msgstr "Симулятор ответа Java"

msgid "Saved Folio response"
msgstr "Сохранённый ответ ФОЛИО"

msgid "A saved Java response exists for this order. Preview what Woo would do before applying it."
msgstr ""
"Для этого заказа есть сохранённый ответ Java. Посмотрите, что сделал бы Woo, "
"перед применением."

msgid "No saved Java response exists for this order yet."
msgstr "Для этого заказа пока нет сохранённого ответа Java."

msgid "Preview saved response actions"
msgstr "Предпросмотр действий по сохранённому ответу"

msgid "Apply saved Folio response"
msgstr "Применить сохранённый ответ ФОЛИО"

msgid "Paste a Java response to preview what Woo would do. This does not save data, create orders, or change statuses."
msgstr ""
"Вставьте ответ Java, чтобы посмотреть, что сделал бы Woo. Это не сохраняет "
"данные, не создаёт заказы и не меняет статусы."

msgid "Paste Java response JSON here..."
msgstr "Вставьте JSON ответа Java здесь..."

msgid "Preview response actions"
msgstr "Предпросмотр действий по ответу"

msgid "warehouse"
msgstr "склад"

msgid "without number"
msgstr "без номера"

msgid "missing quantity"
msgstr "не хватает"

msgid "No changes would be applied. This is a simulation only."
msgstr "Изменения не будут применены. Это только симуляция."

msgid "Result: Java response is not OK. Woo would stop and show an error."
msgstr "Результат: ответ Java не OK. Woo остановится и покажет ошибку."

msgid "Result: no Folio documents found in response."
msgstr "Результат: в ответе не найдены документы ФОЛИО."

msgid "Plan: reuse the original Woo order."
msgstr "План: использовать исходный заказ Woo."

msgid "Save Folio document link on the original order:"
msgstr "Сохранить связь с документом ФОЛИО в исходном заказе:"

msgid "Set original Woo order status to processing."
msgstr "Установить исходному заказу Woo статус processing."

msgid "Plan: keep the original Woo order as parent/draft."
msgstr "План: оставить исходный заказ Woo как родительский/черновик."

msgid "Create child Woo order for real Folio account:"
msgstr "Создать дочерний заказ Woo для реального счёта ФОЛИО:"

msgid "Child status:"
msgstr "Статус дочернего заказа:"

msgid "Create missing-stock draft/on-hold Woo order:"
msgstr "Создать черновик/on-hold заказ Woo для недостающего товара:"

msgid "Reason:"
msgstr "Причина:"

msgid "Warnings:"
msgstr "Предупреждения:"

msgid "Creating Folio account(s)..."
msgstr "Создание счёта(ов) ФОЛИО..."

msgid "Create real Folio account documents now? Woo will only save the Java response; child orders will not be created yet."
msgstr ""
"Создать реальные счета ФОЛИО сейчас? Woo только сохранит ответ Java; "
"дочерние заказы пока не будут созданы."

msgid "Creation cancelled."
msgstr "Создание отменено."

msgid "Invalid JSON:"
msgstr "Некорректный JSON:"

msgid "Sending preview to Java..."
msgstr "Отправка preview в Java..."

msgid "Invalid preview JSON:"
msgstr "Некорректный preview JSON:"

msgid "Java preview request failed."
msgstr "Запрос preview к Java не удался."

msgid "Java create request failed."
msgstr "Запрос создания к Java не удался."

msgid "Java response saved to Woo order meta."
msgstr "Ответ Java сохранён в meta заказа Woo."

msgid "Loading saved Folio response..."
msgstr "Загрузка сохранённого ответа ФОЛИО..."

msgid "Saved Folio response could not be loaded."
msgstr "Не удалось загрузить сохранённый ответ ФОЛИО."

msgid "Apply the saved Folio response to Woo now? This will only save links/status markers; child orders will not be created yet."
msgstr ""
"Применить сохранённый ответ ФОЛИО к Woo сейчас? Будут сохранены только "
"связи/статусные маркеры; дочерние заказы пока не будут созданы."

msgid "Applying saved Folio response..."
msgstr "Применение сохранённого ответа ФОЛИО..."

msgid "Saved Folio response could not be applied."
msgstr "Не удалось применить сохранённый ответ ФОЛИО."

msgid "Saved Folio response applied."
msgstr "Сохранённый ответ ФОЛИО применён."

msgid "Folio account response was saved. Child Woo orders were not created yet."
msgstr ""
"Ответ по счетам ФОЛИО сохранён. Дочерние заказы Woo пока не создавались."

msgid "Forbidden."
msgstr "Запрещено."

msgid "Invalid preview JSON."
msgstr "Некорректный preview JSON."

msgid "Invalid Java preview response."
msgstr "Некорректный preview-ответ Java."

msgid "Folio documents are already saved for this order."
msgstr "Документы ФОЛИО уже сохранены для этого заказа."

msgid "Invalid Java create response."
msgstr "Некорректный ответ Java на создание."

msgid "Folio account creation failed. Java response was saved for review."
msgstr "Создание счёта ФОЛИО не удалось. Ответ Java сохранён для проверки."

msgid "Java response is not OK."
msgstr "Ответ Java не OK."

msgid "No saved Folio response found for this order."
msgstr "Для этого заказа не найден сохранённый ответ ФОЛИО."

msgid "Saved Folio response is not OK."
msgstr "Сохранённый ответ ФОЛИО не OK."

msgid "Could not build Folio document link from saved response."
msgstr "Не удалось построить связь с документом ФОЛИО из сохранённого ответа."

msgid "Saved Folio response applied: linked one Folio account."
msgstr "Сохранённый ответ ФОЛИО применён: привязан один счёт ФОЛИО."

msgid "Saved Folio response applied. Linked document %s."
msgstr "Сохранённый ответ ФОЛИО применён. Привязан документ %s."

msgid "Saved Folio response is already marked ready for split."
msgstr "Сохранённый ответ ФОЛИО уже помечен как готовый к разделению."

msgid "Saved Folio response marked ready for Woo split. Child orders were not created yet."
msgstr ""
"Сохранённый ответ ФОЛИО помечен как готовый к разделению Woo. Дочерние "
"заказы пока не создавались."

msgid "Real Folio account: %s"
msgstr "Реальный счёт ФОЛИО: %s"

msgid "Missing-stock Folio account: %s"
msgstr "Счёт ФОЛИО для недостающего товара: %s"

msgid "Saved Folio response marked ready for split. No child orders were created yet."
msgstr ""
"Сохранённый ответ ФОЛИО помечен как готовый к разделению. Дочерние заказы "
"пока не создавались."

msgid "warehouse %s"
msgstr "склад %s"
