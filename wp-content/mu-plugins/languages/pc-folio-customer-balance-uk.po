msgid "No operations were found for the selected period."
msgstr "За вибраний період операцій не знайдено."

msgid "The report was generated from active Folio documents as of %s."
msgstr "Звіт сформовано за активними документами ФОЛІО станом на %s."

msgid "Warehouse"
msgstr "Склад"

msgid "Folio document ID"
