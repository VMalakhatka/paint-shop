#. Plugin Name of the plugin
#: paint-nova-poshta-multishipping.php
msgid "Paint Nova Poshta Multishipping"
msgstr "Багатоскладська Нова пошта"

#. Description of the plugin
#: paint-nova-poshta-multishipping.php
msgid "Direct multi-warehouse Nova Poshta integration for WooCommerce orders."
msgstr "Пряма багатоскладська інтеграція Нової пошти для замовлень WooCommerce."

#. Author of the plugin
