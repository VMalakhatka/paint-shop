msgstr "Project-Id-Version: Lavka Workshops 2.0.0\nContent-Type: text/plain; charset=UTF-8\nLanguage: uk\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#, php-format
msgid "%s min"
msgstr "%s хв"

msgid "1. Add a title and cover photo. 2. Write the article like a Word document; use Add Media for photos. 3. Fill in the dates below and publish."
msgstr "1. Додайте назву та обкладинку. 2. Напишіть статтю як у Word; фото вставляйте кнопкою «Додати медіа». 3. Заповніть дати нижче та опублікуйте."

msgid "A few hours offline. Something beautiful to take home."
msgstr "Кілька годин для себе. Щось прекрасне — із собою."

msgid "A little time for creativity"
msgstr "Трохи часу для творчості"

msgid "Add date"
msgstr "Додати дату"

msgid "Add workshop"
msgstr "Додати майстер-клас"

msgid "All cities"
msgstr "Усі міста"

msgid "All current dates are fully booked. Please check back for new dates."
msgstr "На всі поточні дати місця вже зайняті. Незабаром додамо нові."

msgid "All times are Kyiv time"
msgstr "Час указано за Києвом"

msgid "All upcoming dates"
msgstr "Усі найближчі дати"

msgid "All workshops"
msgstr "Усі майстер-класи"

msgid "Author"
msgstr "Автор"

msgid "Availability"
msgstr "Наявність місць"

msgid "Booking open"
msgstr "Запис відкрито"

msgid "Booking request"
msgstr "Заявка на майстер-клас"

msgid "Booking requests"
msgstr "Заявки на МК"

msgid "Cancelled"
msgstr "Скасовано"

msgid "Check the date, city, address, duration and price in every row."
msgstr "Перевірте дату, місто, адресу, тривалість і ціну в кожному рядку."

msgid "Choose a date"
msgstr "Обрати дату"

msgid "Choose a workshop, bring your curiosity and create something of your own."
msgstr "Оберіть майстер-клас, дайте волю цікавості та створіть щось своє."

msgid "Choose cover photo"
msgstr "Обрати фото обкладинки"

msgid "Choose your date"
msgstr "Оберіть зручну дату"

msgid "City"
msgstr "Місто"

msgid "Confirmed"
msgstr "Підтверджено"

msgid "Contact the guest yourself. Changing the status does not send a message or change availability."
msgstr "Зв’яжіться з гостем самостійно. Зміна статусу не надсилає повідомлень і не змінює наявність місць."

msgid "Copy date"
msgstr "Копіювати дату"

msgid "Could not confirm receipt. Your details are still here. Please try again; repeated requests will not create a duplicate."
msgstr "Не вдалося підтвердити отримання. Ваші дані збережено у формі. Спробуйте ще раз — повтор не створить дубль."

msgid "Cover photo"
msgstr "Фото обкладинки"

msgid "Date"
msgstr "Дата"

msgid "Dates and booking"
msgstr "Дати та запис"

msgid "Describe the artwork and the experience in a few sentences."
msgstr "Кількома реченнями опишіть роботу, яку створять гості, та процес заняття."

msgid "Duplicate date identifier. Reload the editor."
msgstr "Повторюється ідентифікатор дати. Перезавантажте редактор."

msgid "Duration, minutes"
msgstr "Тривалість, хвилини"

msgid "Edit workshop"
msgstr "Редагувати майстер-клас"

msgid "Explain what to bring and when guests can collect their artwork."
msgstr "Розкажіть, що взяти із собою та коли можна забрати готову роботу."

msgid "Explore workshop"
msgstr "Про майстер-клас"

msgid "Fully booked"
msgstr "Місць немає"

msgid "Good to know"
msgstr "Важливо знати"

msgid "Guest"
msgstr "Гість"

msgid "Guidance from the instructor"
msgstr "Підтримка майстра"

msgid "I agree to be contacted about this workshop using the details I provided."
msgstr "Погоджуюся на зв’язок щодо цього майстер-класу за вказаними мною контактами."

msgid "Kyiv"
msgstr "Київ"

msgid "LAVKA · CREATIVE STUDIO"
msgstr "ЛАВКА · ТВОРЧА СТУДІЯ"

msgid "LET’S CREATE TOGETHER"
msgstr "ТВОРІМО РАЗОМ"

msgid "Make time for"
msgstr "Знайдіть час"

msgid "Materials and tools"
msgstr "Матеріали та інструменти"

msgid "Materials, inspiration and your next favourite memory."
msgstr "Матеріали, натхнення та ваш новий теплий спогад."

msgid "Move to trash"
msgstr "Перемістити в кошик"

msgid "New creative dates are on their way"
msgstr "Нові творчі зустрічі вже скоро"

msgid "New dates will appear here soon. Please check the schedule later."
msgstr "Незабаром тут з’являться нові дати. Перевірте розклад пізніше."

msgid "New request"
msgstr "Нова заявка"

msgid "No payment now. Your place is confirmed personally by the instructor."
msgstr "Зараз оплачувати не потрібно. Майстер особисто підтвердить ваше місце."

msgid "Odesa"
msgstr "Одеса"

msgid "Phone number"
msgstr "Номер телефону"

msgid "Please check your name, phone number and consent, then try again."
msgstr "Перевірте ім’я, номер телефону та згоду й спробуйте ще раз."

msgid "Price, UAH"
msgstr "Ціна, грн"

msgid "Privacy policy"
msgstr "Політика конфіденційності"

msgid "Received"
msgstr "Отримано"

msgid "Remove"
msgstr "Прибрати"

msgid "Remove this date? Existing requests will remain in the request list."
msgstr "Прибрати цю дату? Наявні заявки залишаться у списку заявок."

msgid "Request a place"
msgstr "Записатися на МК"

msgid "Request received. The instructor will contact you to confirm your place."
msgstr "Заявку отримано. Майстер зв’яжеться з вами, щоб підтвердити місце."

msgid "Requests do not reserve seats automatically. Set Fully booked when the group is complete. If guests have already signed up, contact them before changing or cancelling a date."
msgstr "Заявки не резервують місця автоматично. Коли групу набрано, оберіть «Місць немає». Якщо вже є заявки, зв’яжіться з гостями перед зміною або скасуванням дати."

msgid "Reset filters"
msgstr "Скинути фільтри"

msgid "Save status"
msgstr "Зберегти статус"

msgid "Schedule not saved. The previous dates have been kept."
msgstr "Розклад не збережено. Попередні дати залишилися без змін."

msgid "Schedule pages"
msgstr "Сторінки розкладу"

msgid "Sending…"
msgstr "Надсилаємо…"

msgid "Show workshops"
msgstr "Показати майстер-класи"

msgid "Status"
msgstr "Статус"

msgid "Studio address"
msgstr "Адреса студії"

msgid "Tell guests about the age range and experience level."
msgstr "Укажіть вік учасників і потрібний рівень досвіду."

msgid "The excerpt is the short text on the schedule card. Preview lets you check the article before publishing."
msgstr "Уривок — короткий текст на картці розкладу. Попередній перегляд дає змогу перевірити статтю перед публікацією."

msgid "The request could not be saved. Please try again."
msgstr "Не вдалося зберегти заявку. Спробуйте ще раз."

msgid "There are no workshops for this selection yet. Try another city or month."
msgstr "За цими умовами занять поки немає. Оберіть інше місто або місяць."

msgid "These are the details at the time of the request. Check the current schedule before confirming with the guest."
msgstr "Це дані на момент заявки. Перед підтвердженням гостю перевірте поточний розклад."

msgid "This date is no longer available. Please reload and choose another date."
msgstr "Запис на цю дату вже закрито. Оновіть сторінку й оберіть іншу."

msgid "This form has expired. Reload the page and try again."
msgstr "Форма застаріла. Оновіть сторінку й спробуйте ще раз."

msgid "Three simple steps"
msgstr "Три прості кроки"

msgid "Time"
msgstr "Час"

msgid "Times are in Kyiv time. One article can have several dates. Copy a row to add the next class."
msgstr "Час указано за Києвом. Одна стаття може мати кілька дат. Копіюйте рядок, щоб додати наступне заняття."

msgid "Too many requests. Please try again in a few minutes."
msgstr "Забагато заявок. Спробуйте за кілька хвилин."

msgid "Upcoming dates"
msgstr "Найближчі дати"

msgid "Upcoming workshops"
msgstr "Найближчі майстер-класи"

msgid "Use at most 100 dates per workshop."
msgstr "Додайте не більше 100 дат до одного майстер-класу."

msgid "View schedule"
msgstr "Переглянути розклад"

msgid "What is included"
msgstr "Що входить у вартість"

msgid "What we will create"
msgstr "Що ми створимо"

msgid "When"
msgstr "Коли"

msgid "Who it is for"
msgstr "Для кого цей майстер-клас"

msgid "Workshop"
msgstr "Майстер-клас"

msgid "Workshop instructor"
msgstr "Майстер МК"

msgid "Workshops"
msgstr "Майстер-класи"

msgid "YOUR CREATIVE PAUSE"
msgstr "ВАША ТВОРЧА ПАУЗА"

msgid "Your name"
msgstr "Ваше ім’я"

msgid "Your place at the table"
msgstr "Ваше місце за мольбертом"

msgid "Your request is being processed. Please wait a moment and try again."
msgstr "Заявка обробляється. Трохи зачекайте й спробуйте ще раз."

msgid "something beautiful."
msgstr "для прекрасного."

msgid "Introduce the idea and atmosphere in two or three sentences."
msgstr "Опишіть ідею та атмосферу двома-трьома реченнями."

msgid "Give yourself a creative pause. At this workshop we will explore [technique] and create [artwork]. Choose your colours and enjoy the process at your own pace."
msgstr "Подаруйте собі творчу паузу. На майстер-класі ми спробуємо [техніка] та створимо [робота]. Обирайте свої кольори й насолоджуйтеся процесом у власному темпі."

msgid "Describe the result: the artwork, its size and the techniques guests will try."
msgstr "Опишіть результат: роботу, її розмір та техніки, які спробують гості."

msgid "You will create [artwork and size]. We will start with [first step], practise [technique] and add the finishing touches. Every participant will have their own unique result."
msgstr "Ви створите [робота та розмір]. Почнемо з [перший крок], спробуємо [техніка] та додамо завершальні штрихи. Кожен учасник отримає свій неповторний результат."

msgid "Specify age and experience requirements. Do not promise suitability you have not checked."
msgstr "Вкажіть вік учасників і потрібний досвід."

msgid "This workshop is for [age group]. Experience required: [none / basic skills]. It is a lovely way to [try a new technique / spend time with friends / develop your skills]."
msgstr "Заняття розраховане на [вік учасників]. Потрібний досвід: [не потрібен / базові навички]. Це нагода [спробувати нову техніку / провести час із друзями / розвинути свої вміння]."

msgid "List only the materials and services actually included in your price."
msgstr "Перелічіть матеріали та послуги, які входять у вашу ціну."

msgid "Included in the price:\\n• [canvas or other base]\\n• [paints and tools]\\n• [instructor guidance]\\n• [other included items]"
msgstr "У вартість входить:\n• [полотно або інша основа]\n• [фарби та інструменти]\n• [супровід майстра]\n• [інші включені послуги]"

msgid "What should guests bring? When can they collect their work? Explain cancellation terms."
msgstr "Що взяти із собою? Коли забрати роботу? Які умови скасування?"

msgid "Please arrive [number] minutes before the start. Bring [what is needed]. Your artwork can be collected [when and how]. If your plans change, contact us [cancellation terms]."
msgstr "Приходьте за [кількість] хвилин до початку. Візьміть із собою [що потрібно]. Готову роботу можна забрати [коли та як]. Якщо плани зміняться, повідомте нас [умови скасування]."

msgid "Your workshop article"
msgstr "Ваша стаття про майстер-клас"

msgid "Fill in the sections below. The website will arrange them into a finished article. Empty sections are not shown."
msgstr "Заповніть розділи нижче — сайт складе з них готову статтю. Порожні розділи не показуються."

msgid "View saved article"
msgstr "Переглянути збережену статтю"

msgid "Save your changes first, then open the article. Use the standard Preview changes button to preview unsaved text."
msgstr "Спочатку збережіть зміни, потім відкрийте статтю. Для перегляду незбереженого тексту натисніть стандартну кнопку «Переглянути зміни»."

msgid "Article sections"
msgstr "Розділи статті"

msgid "Insert example into empty section"
msgstr "Вставити приклад у порожній розділ"

msgid "Example added. Replace the text in brackets with your details."
msgstr "Приклад додано. Замініть текст у дужках своїми даними."

msgid "This section already contains text or a photo. Your content has been kept."
msgstr "У цьому розділі вже є текст або фото. Ваш вміст збережено без змін."

msgid "1. Add a title and cover photo. 2. Fill in the article sections; insert examples into empty fields if useful. 3. Add dates, save and view your article."
msgstr "1. Додайте назву та обкладинку. 2. Заповніть розділи статті; за потреби вставте приклади в порожні поля. 3. Додайте дати, збережіть та перегляньте статтю."

msgid "About the workshop"
msgstr "Про майстер-клас"

msgid "Give yourself a creative pause. Describe the idea of your workshop and the experience your guests will enjoy."
msgstr "Подаруйте собі творчу паузу. Опишіть ідею майстер-класу та враження, які отримають гості."

msgid "Describe the artwork, its size and the techniques you will explore together. Replace this example with your own story."
msgstr "Опишіть майбутню роботу, її розмір і техніки, які ви спробуєте разом. Замініть цей приклад власною розповіддю."

msgid "Add a thought, a participant’s impression or a short quotation. Name the author when quoting someone."
msgstr "Додайте думку, враження учасника або коротку цитату. Для цитати вкажіть автора."

msgid "Who is this workshop for? What is included? What should guests bring, and when can they collect their artwork? Add your actual details here."
msgstr "Для кого це заняття? Що входить у вартість? Що взяти із собою і коли забрати роботу? Додайте тут актуальні подробиці."

msgid "Meet your instructor"
msgstr "Знайомство з майстром"

msgid "Introduce yourself: your name, favourite techniques and how you help participants create their own work."
msgstr "Розкажіть про себе: ваше ім’я, улюблені техніки та як ви допомагаєте учасникам створювати власні роботи."

msgid "Moments from the studio"
msgstr "Миті з майстерні"

msgid "Join us at the studio"
msgstr "Зустрінемось у майстерні"

msgid "Choose a convenient date in the booking form below. The instructor will contact you to confirm your request."
msgstr "Оберіть зручну дату у формі запису нижче. Майстер зв’яжеться з вами для підтвердження заявки."

msgid "Workshop presentation"
msgstr "Майстер-клас"

msgid "A welcoming introduction, photo with text, practical details and an invitation to book."
msgstr "Вступ, фото з текстом, важливі подробиці та запрошення записатися."

msgid "Creative article"
msgstr "Творча стаття"

msgid "An introduction, a large photo, story sections and a highlighted quotation."
msgstr "Вступ, велике фото, розділи розповіді та виразна цитата."

msgid "The story behind the artwork"
msgstr "Історія створення роботи"

msgid "Tell your story here. Add observations, useful advice and details that help the reader see the creative process through your eyes."
msgstr "Розкажіть свою історію. Додайте спостереження, корисні поради та подробиці, що допоможуть читачеві побачити творчий процес вашими очима."

msgid "Studio photo report"
msgstr "Фотозвіт із майстерні"

msgid "A short story about the event, two photos, a gallery and participant impressions."
msgstr "Коротка розповідь про подію, два фото, галерея та враження учасників."

msgid "Tell readers when the event took place, what you created together and what made the day special."
msgstr "Розкажіть, коли відбулася подія, що ви створили разом і чим запам’ятався цей день."

msgid "Photo and text"
msgstr "Фото і текст"

msgid "Two photos side by side"
msgstr "Два фото поруч"

msgid "Highlighted quotation"
msgstr "Виразна цитата"

msgid "Practical details"
msgstr "Важливі подробиці"

msgid "Photo gallery"
msgstr "Фотогалерея"

msgid "Booking invitation"
msgstr "Запрошення записатися"

msgid "Lavka · Studio"
msgstr "Лавка · Майстерня"

msgid "Lavka · Publication studio"
msgstr "Лавка · Конструктор публікації"

msgid "Choose a starting layout"
msgstr "Оберіть початковий макет"

msgid "Start with a finished composition, replace the text and add your photos. Every block can be moved, duplicated or removed."
msgstr "Почніть із готової композиції, замініть текст і додайте власні фото. Кожен блок можна пересунути, скопіювати або видалити."

msgid "Start with a blank page"
msgstr "Почати з чистої сторінки"

msgid "Add a composition"
msgstr "Додати композицію"

msgid "Click text to write. Use the plus button for blocks and List View to move sections. Add the cover, excerpt and dates before publishing."
msgstr "Натисніть на текст, щоб писати. Додавайте блоки кнопкою «+», а розділи пересувайте в «Перегляді списком». Перед публікацією додайте обкладинку, уривок та дати."

msgid "Convert existing text to blocks"
msgstr "Перетворити старий текст на блоки"

msgid "Your earlier article is preserved. Convert it to movable blocks, review the result, then save. Undo is available before saving."
msgstr "Попередня стаття збережена. Перетворіть її на рухомі блоки, перевірте результат і збережіть. До збереження можна скасувати дію."

msgid "Save first to view the latest article. Use Preview for unsaved changes."
msgstr "Спочатку збережіть зміни, потім відкрийте статтю. Для незбережених правок скористайтеся попереднім переглядом."
