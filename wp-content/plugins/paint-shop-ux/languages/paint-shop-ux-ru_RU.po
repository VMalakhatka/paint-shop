msgid "Product categories"
msgstr "Категории товаров"

msgid "Open catalogue"
msgstr "Открыть каталог"

msgid "Expand %s"
msgstr "Развернуть %s"

msgid "Collapse %s"
msgstr "Свернуть %s"

msgid "Loading categories..."
msgstr "Загрузка категорий..."

msgid "Categories could not be loaded."
msgstr "Не удалось загрузить категории."

