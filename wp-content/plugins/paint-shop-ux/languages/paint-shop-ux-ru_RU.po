msgstr "Показывать количество товаров"

msgid "Category menu settings changed or could not be saved. Reload this page and check the saved migration before retrying."
msgstr "Настройки меню изменились или их не удалось сохранить. Обновите страницу и проверьте сохранённое состояние переноса перед повторной попыткой."

msgid "Access denied."
msgstr "Доступ запрещён."

msgid "Activate WPB before restoring its widgets."
msgstr "Включите WPB перед восстановлением его виджетов."

msgid "Category menu settings saved."
msgstr "Настройки меню категорий сохранены."

msgid "Edit widgets"
msgstr "Редактировать виджеты"

msgid "Current widget"
msgstr "Текущий виджет"

msgid "Replacement"
msgstr "Замена"

msgid "No category widgets to migrate."
msgstr "Нет виджетов категорий для переноса."

msgid "Unsupported WPB widget left unchanged:"
msgstr "Неподдерживаемый виджет WPB оставлен без изменений:"

msgid "Replace category widgets"
msgstr "Заменить виджеты категорий"

msgid "Migration backup is available."
msgstr "Резервная копия настроек переноса доступна."

msgid "Restore WPB widgets"
msgstr "Восстановить виджеты WPB"

msgid "WPB is not disabled automatically. Check its other widgets, shortcodes and templates before deactivation. To restore the old menu, activate WPB first."
msgstr "WPB не отключается автоматически. Перед отключением проверьте другие его виджеты, шорткоды и шаблоны. Для восстановления старого меню сначала включите WPB."
msgid "Products per page"
msgstr "Товаров на странице"

msgid "Show:"
msgstr "Показывать:"

msgid "Invalid category selection."
msgstr "Некорректный выбор категорий."

msgid "Category settings could not be saved."
msgstr "Не удалось сохранить настройки категорий."

msgid "Hidden categories"
msgstr "Скрытые категории"

msgid "Always hide categories and their subcategories"
msgstr "Всегда скрывать категории и их подкатегории"

msgid "Search categories"
msgstr "Поиск категорий"

msgid "Save changes"
msgstr "Сохранить изменения"
