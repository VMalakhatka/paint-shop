msgstr "Магазин временно приостановил доставку в Telegram."

msgid "Telegram disconnected. Your conversation history remains on the website."
msgstr "Telegram отключён. История переписки остаётся на сайте."

msgid "Telegram is busy. Please retry."
msgstr "Telegram занят. Повторите попытку."

msgid "Telegram is enabled."
msgstr "Telegram включён."

msgid "Telegram is linked. New public manager replies will also arrive in the bot."
msgstr "Telegram подключён. Новые ответы менеджера для вас также будут приходить в бот."

msgid "Telegram is not enabled."
msgstr "Telegram ещё не включён."

msgid "Telegram record could not be saved."
msgstr "Не удалось сохранить запись Telegram."

msgid "Telegram requires the public HTTPS site."
msgstr "Для Telegram нужен доступный из интернета сайт с HTTPS."

msgid "Telegram setup"
msgstr "Настройка Telegram"

msgid "Telegram storage is unavailable."
msgstr "Хранилище Telegram недоступно."

msgid "Telegram: accepted by Telegram, not a read receipt."
msgstr "Telegram: принято сервисом, прочтение не подтверждено."

msgid "Telegram: delivery cancelled after disconnection."
msgstr "Telegram: отправка отменена после отключения."

msgid "Telegram: delivery failed. The reply is saved on the website."
msgstr "Telegram: не удалось доставить. Ответ сохранён на сайте."

msgid "Telegram: delivery unknown; check with the customer before resending."
msgstr "Telegram: результат доставки неизвестен; уточните у клиента перед повторной отправкой."

msgid "Telegram: queued."
msgstr "Telegram: в очереди."

msgid "Telegram: sending."
msgstr "Telegram: отправляется."

msgid "This bot is already connected elsewhere, or its webhook could not be checked."
msgstr "Этот бот уже подключён к другому сервису или не удалось проверить его webhook."

msgid "This link is expired or unavailable. Create a new link in your website account."
msgstr "Эта ссылка просрочена или недоступна. Создайте новую в кабинете на сайте."

msgid "This reply could not be linked. Use /threads to select the conversation and send it again."
msgstr "Не удалось определить обращение для ответа. Выберите его командой /threads и отправьте сообщение ещё раз."

msgid "Use the same bot. Changing bots requires a separate migration."
msgstr "Используйте того же бота. Замена бота требует отдельного переноса."

msgid "Verify and enable Telegram"
msgstr "Проверить и включить Telegram"

msgid "Webhook activation was not confirmed. The channel remains paused; retry setup explicitly."
msgstr "Активация webhook не подтверждена. Канал остаётся приостановленным; повторите настройку вручную."

msgid "Write your general question to the manager."
msgstr "Напишите общий вопрос менеджеру."

#, php-format
msgid "Write your message for conversation #%d. Selection is valid for 30 minutes."
msgstr "Напишите сообщение для обращения №%d. Выбор действует 30 минут."

msgid "Enable text conversations for registered customers and wholesale accounts. Telegram is configured separately below."
msgstr "Включить текстовые обращения для зарегистрированных покупателей и оптовых клиентов. Telegram настраивается отдельно ниже."

#: inc/TelegramSettings.php:93
msgid "My Telegram for customer conversations"
msgstr "Мой Telegram для работы с клиентами"

#: inc/TelegramSettings.php:95
msgid "Telegram is linked. Receive your assigned conversations and the unassigned queue. Reply to a specific bot message to answer the customer."
msgstr "Telegram подключён. Вы будете получать свои обращения и общую очередь без ответственного. Чтобы ответить клиенту, выберите «Ответить» на конкретном сообщении бота."

#: inc/TelegramSettings.php:96
msgid "Use /threads for your conversations and /queue for unassigned requests. Take a request before replying. Replies are public; write internal notes only on the website."
msgstr "Команда /threads показывает ваши обращения, /queue — без ответственного. Сначала возьмите обращение в работу. Ответы видит клиент; внутренние заметки пишите только на сайте."

#: inc/TelegramSettings.php:101
msgid "Connect your own Telegram to receive customer messages and take unassigned requests. After Start, return here and confirm your identity. Do not share the one-time link."
msgstr "Подключите собственный Telegram, чтобы получать сообщения клиентов и брать обращения без ответственного. После Start вернитесь сюда и подтвердите свой аккаунт. Не передавайте одноразовую ссылку."

