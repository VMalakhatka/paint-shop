msgid "Running"
msgstr "Виконується"

#: inc/accounting-prices.php:119 inc/accounting-prices.php:180
#: inc/accounting-prices.php:193
msgid "Completed"
msgstr "Завершено"

#: inc/accounting-prices.php:125 inc/accounting-prices.php:191
#: inc/accounting-prices.php:205
msgid "Completed with skipped products"
msgstr "Завершено з пропущеними товарами"

#: inc/accounting-prices.php:120 inc/accounting-prices.php:181
msgid "Stopped on negative stock"
msgstr "Зупинено через від'ємний залишок"

#: inc/accounting-prices.php:121 inc/accounting-prices.php:182
#: inc/accounting-prices.php:194
msgid "Failed"
msgstr "Помилка"

#: inc/accounting-prices.php:122 inc/accounting-prices.php:183
#: inc/accounting-prices.php:196
msgid "Failed after partial recalculation"
msgstr "Помилка після часткового перерахунку"

#: inc/accounting-prices.php:123 inc/accounting-prices.php:178
msgid "Check passed"
msgstr "Перевірку пройдено"

#: inc/accounting-prices.php:130 inc/accounting-prices.php:188
msgid "Check passed with skipped products"
msgstr "Перевірку пройдено з пропущеними товарами"

#: inc/accounting-prices.php:124
msgid "Check blocked recalculation"
msgstr "Перевірка заблокувала перерахунок"

#: inc/accounting-prices.php:125 inc/accounting-prices.php:179
msgid "Blocked by negative stock"
msgstr "Заблоковано через від'ємний залишок"

#: inc/accounting-prices.php:126 inc/accounting-prices.php:184
#: inc/accounting-prices.php:197
