msgid "The product was first found in Folio and has not yet received a confirmed recalculation."
msgstr "Товар уперше знайдено у ФОЛІО, і для нього ще немає підтвердженого перерахунку."

msgid "The Folio movement fingerprint changed after the last confirmed recalculation."
msgstr "Відбиток рухів ФОЛІО змінився після останнього підтвердженого перерахунку."

msgid "The product recalculation failed. Review the saved error and correct the Folio data before retrying."
msgstr "Перерахунок товару завершився помилкою. Перегляньте збережену помилку та виправте дані ФОЛІО перед повторним запуском."

msgid "The product existed in an earlier snapshot but is absent from the current Folio warehouse snapshot."
msgstr "Товар був у попередньому знімку, але відсутній у поточному знімку складу ФОЛІО."

msgid "Select a supported snapshot state."
msgstr "Оберіть підтримуваний стан знімка."

msgid "The Folio product snapshot tables are unavailable."
msgstr "Таблиці знімка товарів ФОЛІО недоступні."

msgid "No completed snapshot is available for this campaign."
msgstr "Для цієї кампанії немає доступного завершеного знімка."

