msgstr "Единицы прогресса"

#: inc/accounting-prices.php:131
msgid "Warnings"
msgstr "Предупреждения"

#: inc/accounting-prices.php:132
msgid "SKU list copied."
msgstr "Список артикулов скопирован."

#: inc/accounting-prices.php:133
msgid "There are no warnings to export."
msgstr "Нет предупреждений для экспорта."

#: inc/accounting-prices.php:134
msgid "Java API returned HTTP"
msgstr "API сервиса ФОЛИО вернул HTTP"

#: inc/accounting-prices.php:135
msgid "Request ID"
msgstr "ID запроса"

