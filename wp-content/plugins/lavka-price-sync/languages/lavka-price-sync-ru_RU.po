msgid "SKU"
msgstr "Артикул"

#: inc/accounting-price-campaign.php:932 inc/accounting-prices.php:226
msgid "SKU count"
msgstr "Количество SKU"

#: inc/accounting-price-campaign.php:933 inc/accounting-prices.php:229
msgid "Message"
msgstr "Сообщение"

#: inc/accounting-price-campaign.php:934 inc/accounting-prices.php:117
#: inc/accounting-prices.php:231 inc/accounting-prices.php:853
#: inc/accounting-prices.php:920
msgid "Technical details"
msgstr "Технические подробности"

#: inc/accounting-price-campaign.php:941
msgid "Batch or warehouse result"
msgstr "Результат порции или склада"

#: inc/accounting-price-campaign.php:957 inc/logs.php:122
