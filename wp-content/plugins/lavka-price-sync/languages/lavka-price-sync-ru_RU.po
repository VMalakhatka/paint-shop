msgstr "Заблокировано"

#: inc/accounting-prices.php:131
msgid "Waiting in queue"
msgstr "Ожидание в очереди"

#: inc/accounting-prices.php:132
msgid "Rollback preflight is running"
msgstr "Выполняется предварительная проверка с откатом"

#: inc/accounting-prices.php:133
msgid "Rollback preflight completed"
msgstr "Предварительная проверка с откатом завершена"

#: inc/accounting-prices.php:134
msgid "Applying recalculation portions"
msgstr "Применяются порции пересчёта"

#: inc/accounting-prices.php:135
