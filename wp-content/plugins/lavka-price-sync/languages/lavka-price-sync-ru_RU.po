#: inc/accounting-prices.php:196
msgid "Failed after partial recalculation"
msgstr "Ошибка после частичного пересчёта"

#: inc/accounting-prices.php:123 inc/accounting-prices.php:178
msgid "Check passed"
msgstr "Проверка пройдена"

#: inc/accounting-prices.php:130 inc/accounting-prices.php:188
msgid "Check passed with skipped products"
msgstr "Проверка пройдена с пропущенными товарами"

#: inc/accounting-prices.php:124
msgid "Check blocked recalculation"
msgstr "Проверка заблокировала пересчёт"

