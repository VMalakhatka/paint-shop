msgstr "Элемент товара должен быть одним именем XML-элемента."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "The server needs XMLReader and DOM support."
msgstr "На сервере нужна поддержка XMLReader и DOM."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "The XML file is empty or exceeds 60 MiB."
msgstr "XML-файл пуст или превышает 60 МиБ."


