msgstr "XML неполный или повреждён. Предыдущий каталог сохранён."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "No products found. Check the product element and field mapping."
msgstr "Товары не найдены. Проверьте элемент товара и соответствие полей."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "Use a public HTTP or HTTPS URL without embedded credentials."
msgstr "Используйте публичную HTTP- или HTTPS-ссылку без встроенного логина и пароля."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "The supplier could not be reached. Try again later or upload a saved XML file."
msgstr "Поставщик недоступен. Попробуйте позже или загрузите сохранённый XML-файл."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "The supplier refused the download. Open the source in your browser or upload a saved XML file."
msgstr "Поставщик отклонил скачивание. Откройте источник в браузере или загрузите сохранённый XML-файл."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "The downloaded file is empty or too large."
msgstr "Скачанный файл пуст или слишком велик."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
msgid "Select a saved supplier."
msgstr "Выберите сохранённого поставщика."


#: inc/class-supplier-catalog.php inc/class-supplier-feed.php inc/supplier-page.php inc/supplier-strings.php
