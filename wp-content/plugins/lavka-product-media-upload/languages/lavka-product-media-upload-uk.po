#. Plugin Name of the plugin
#: lavka-product-media-upload.php
msgid "Lavka Product Media Upload"
msgstr "Пакетне завантаження зображень Lavka"

#. Description of the plugin
#: lavka-product-media-upload.php
msgid ""
"Validates product image batches from XLS/XLSX manifests and reports naming, "
"product, WordPress and S3 conflicts."
msgstr ""
"Перевіряє пакети зображень товарів за реєстрами XLS/XLSX і повідомляє про "
"конфлікти імен, товарів, WordPress та S3."

#. Author of the plugin
#: lavka-product-media-upload.php
msgid "Volodymyr"
msgstr "Volodymyr"

#: inc/class-batch-service.php:97 inc/class-plugin.php:343
msgid "File writing is disabled for this verification stage."
msgstr "Запис файлів вимкнено на цьому етапі перевірки."

#: inc/class-batch-service.php:102
msgid "The dry-run token has expired or belongs to another user."
msgstr ""
"Термін дії токена перевірки минув або він належить іншому користувачеві."

#: inc/class-batch-service.php:105
msgid "The legacy-role confirmation changed after the dry run."
msgstr "Підтвердження ролі для старого формату змінилося після перевірки."

#: inc/class-batch-service.php:108
msgid "The canonical filename option changed after the dry run."
msgstr "Параметр канонічного імені файлу змінився після перевірки."

#: inc/class-batch-service.php:118
msgid ""
"The registry or selected images changed after the dry run. Check the batch "
"again."
msgstr ""
"Реєстр або вибрані зображення змінилися після перевірки. Перевірте пакет ще "
"раз."

#: inc/class-batch-service.php:124
msgid "The registry hash changed after the dry run."
msgstr "Хеш реєстру змінився після перевірки."

#: inc/class-batch-service.php:136
msgid "A row differs from the approved dry-run result."
msgstr "Рядок відрізняється від схваленого результату перевірки."

#: inc/class-image-validator.php:74
msgid "An SKU or barcode is required."
msgstr "Потрібно вказати артикул або штрихкод."

#: inc/class-image-validator.php:77
msgid "The source filename is required."
msgstr "Потрібно вказати ім'я вихідного файлу."

#: inc/class-image-validator.php:80
msgid "The image role must be main or gallery."
msgstr "Роль зображення має бути main або gallery."

#: inc/class-image-validator.php:83
msgid "A gallery image requires a unique positive position."
msgstr "Для зображення галереї потрібна унікальна додатна позиція."

#: inc/class-image-validator.php:87
msgid ""
"The source filename mixes visually similar Latin and Cyrillic letters. "
"Correct it explicitly in the registry."
msgstr ""
"Ім'я вихідного файлу містить візуально схожі латинські та кириличні літери. "
"Виправте його явно в реєстрі."

#: inc/class-image-validator.php:92 inc/class-image-validator.php:142
msgid ""
"The same product, role and position occur more than once in the registry."
msgstr "Однакове поєднання товару, ролі та позиції повторюється в реєстрі."

#: inc/class-image-validator.php:98
msgid "The same source file is referenced by more than one registry row."
msgstr "На один вихідний файл посилається більше одного рядка реєстру."

#: inc/class-image-validator.php:104
msgid "A product can have only one main image in a batch."
msgstr "Товар може мати лише одне головне зображення в пакеті."

#: inc/class-image-validator.php:117
msgid "No selected image matches the registry source filename."
msgstr "Серед вибраних зображень немає файлу з ім'ям із реєстру."

#: inc/class-image-validator.php:120
msgid "More than one selected file matches the registry source filename."
msgstr "Імені файлу з реєстру відповідає більше одного вибраного файлу."

#: inc/class-image-validator.php:147 inc/class-media-uploader.php:343
msgid "WooCommerce variations do not have a standard separate gallery."
msgstr "Варіації WooCommerce не мають стандартної окремої галереї."

#: inc/class-image-validator.php:192
msgid "The canonical filename is duplicated inside this batch."
msgstr "Канонічне ім'я файлу дублюється в цьому пакеті."

#: inc/class-image-validator.php:198
msgid "The same image content occurs more than once in this batch."
msgstr ""
"Однаковий вміст зображення трапляється в цьому пакеті більше одного разу."

#: inc/class-image-validator.php:212
msgid "This exact image was already uploaded and verified. It will be skipped."
msgstr "Це саме зображення вже завантажено й перевірено. Його буде пропущено."

#: inc/class-image-validator.php:220
msgid ""
"A matching attachment from an incomplete earlier attempt will be verified "
"and resumed without creating a duplicate."
msgstr ""
"Відповідне вкладення з незавершеної попередньої спроби буде перевірено та "
"продовжено без створення дубліката."

#: inc/class-image-validator.php:222
msgid "The canonical filename already exists in the WordPress Media Library."
msgstr "Канонічне ім'я файлу вже існує в медіатеці WordPress."

#: inc/class-image-validator.php:243
msgid "The S3 media index could not be checked."
msgstr "Не вдалося перевірити індекс медіа S3."

#: inc/class-image-validator.php:247
msgid "The canonical filename already exists in the S3 media index."
msgstr "Канонічне ім'я файлу вже існує в індексі медіа S3."

#. translators: %s: comma-separated filenames
#: inc/class-image-validator.php:259
#, php-format
msgid ""
"Automatically renamed legacy variants already exist: %s. The approved "
"canonical filename will be uploaded separately; existing variants will not "
"be changed."
msgstr ""
"Вже існують старі автоматично перейменовані варіанти: %s. Файл із "
"затвердженим канонічним ім'ям буде завантажено окремо; наявні варіанти не "
"змінюватимуться."

#: inc/class-image-validator.php:311
msgid "The selected file is not referenced by any registry row."
msgstr "Вибраний файл не вказано в жодному рядку реєстру."

#. translators: %d: PHP upload error code
#: inc/class-image-validator.php:528
#, php-format
msgid "PHP rejected the image upload with error %d."
msgstr "PHP відхилив завантаження зображення з помилкою %d."

#: inc/class-image-validator.php:536
msgid "The image temporary file is missing or is not a valid HTTP upload."
msgstr ""
"Тимчасовий файл зображення відсутній або не є коректним HTTP-завантаженням."

#: inc/class-image-validator.php:540
msgid "The image file is empty."
msgstr "Файл зображення порожній."

#: inc/class-image-validator.php:545
msgid ""
"The uploaded byte count does not match the size declared by the request."
msgstr ""
"Фактична кількість завантажених байтів не відповідає розміру, оголошеному в "
"запиті."

#: inc/class-image-validator.php:550
msgid "The image exceeds the configured hard file-size limit."
msgstr "Зображення перевищує встановлене жорстке обмеження розміру файлу."

#: inc/class-image-validator.php:553
msgid "The image is larger than the configured warning threshold."
msgstr "Зображення більше за встановлений поріг попередження."

#: inc/class-image-validator.php:563
msgid "Only JPEG, PNG and WebP images are allowed."
msgstr "Дозволено лише зображення JPEG, PNG і WebP."

#: inc/class-image-validator.php:569
msgid "The file magic signature is not JPEG, PNG or WebP."
msgstr "Магічна сигнатура файлу не відповідає JPEG, PNG або WebP."

#: inc/class-image-validator.php:575
msgid "The PHP Fileinfo extension is required for MIME verification."
msgstr "Для перевірки MIME потрібне розширення PHP Fileinfo."

#: inc/class-image-validator.php:600
msgid ""
"The extension, magic signature, server MIME and WordPress file check do not "
"agree."
msgstr ""
"Розширення, магічна сигнатура, серверний MIME та перевірка WordPress не "
"збігаються."

#: inc/class-image-validator.php:613
msgid "The image dimensions could not be read."
msgstr "Не вдалося прочитати розміри зображення."

#: inc/class-image-validator.php:619
msgid "The image has invalid dimensions."
msgstr "Зображення має некоректні розміри."

#: inc/class-image-validator.php:622
msgid "The image exceeds the configured geometry or total-pixel limit."
msgstr ""
"Зображення перевищує встановлене обмеження сторони або загальної кількості "
"пікселів."

#: inc/class-image-validator.php:628
msgid ""
"The image is within the configured pixel limit but cannot be decoded safely "
"with the currently available PHP memory."
msgstr ""
"Зображення не перевищує встановлений ліміт пікселів, але його неможливо "
"безпечно декодувати з доступним обсягом пам'яті PHP.Зображення не перевищує "
"встановлений ліміт пікселів, але його неможливо безпечно декодувати з "
"доступним обсягом пам’яті PHP."

#: inc/class-image-validator.php:633
msgid "At least one image side is below the configured minimum-side warning."
msgstr ""
"Щонайменше одна сторона зображення менша за встановлений поріг попередження."

#: inc/class-image-validator.php:636
msgid "At least one image side is above the configured large-side warning."
msgstr ""
"Щонайменше одна сторона зображення більша за встановлений поріг попередження."

#: inc/class-image-validator.php:642
msgid "The image is outside the recommended side range."
msgstr "Розміри зображення виходять за рекомендований діапазон."

#: inc/class-image-validator.php:646
msgid "The image has an unusually wide or tall aspect ratio."
msgstr "Зображення має незвично широке або високе співвідношення сторін."

#: inc/class-image-validator.php:652
msgid "The JPEG bit depth is not supported by the current pipeline."
msgstr "Поточний процес не підтримує цю глибину кольору JPEG."

#: inc/class-image-validator.php:655
msgid ""
"The JPEG appears to use CMYK. RGB or sRGB is preferred for the storefront."
msgstr "Схоже, JPEG використовує CMYK. Для вітрини бажано RGB або sRGB."

#: inc/class-image-validator.php:669
msgid "The WordPress Image Editor could not open the image."
msgstr "Редактор зображень WordPress не зміг відкрити зображення."

#: inc/class-image-validator.php:681
msgid "The WordPress Image Editor reported unexpected image dimensions."
msgstr "Редактор зображень WordPress повернув неочікувані розміри."

#: inc/class-image-validator.php:696
msgid "The external malware scanner rejected the image."
msgstr "Зовнішній сканер шкідливого ПЗ відхилив зображення."

#: inc/class-image-validator.php:751
msgid "The canonical filename exceeds the configured hard length limit."
msgstr "Канонічне ім'я файлу перевищує встановлене жорстке обмеження довжини."

#: inc/class-image-validator.php:754
msgid "The canonical filename exceeds the configured warning length."
msgstr "Канонічне ім'я файлу перевищує встановлений поріг попередження."

#: inc/class-image-validator.php:757
msgid "The canonical filename contains unsupported characters."
msgstr "Канонічне ім'я файлу містить непідтримувані символи."

#: inc/class-image-validator.php:760
msgid "The canonical filename is hidden, reserved or has multiple extensions."
msgstr "Канонічне ім'я приховане, зарезервоване або має кілька розширень."

#: inc/class-image-validator.php:770
msgid "A canonical filename cannot be generated without an identifier."
msgstr "Неможливо створити канонічне ім'я файлу без ідентифікатора."

#: inc/class-image-validator.php:789
msgid "The SKU uses a non-ASCII prefix without an explicit business mapping."
msgstr "Артикул має не-ASCII префікс без явного бізнес-відповідника."

#: inc/class-image-validator.php:796
msgid ""
"The identifier cannot be converted to a safe canonical filename without "
"guessing."
msgstr ""
"Ідентифікатор неможливо перетворити на безпечне канонічне ім'я без припущень."

#: inc/class-image-validator.php:808
msgid "The filename contains NUL or control characters."
msgstr "Ім'я файлу містить NUL або керівні символи."

#: inc/class-image-validator.php:817
msgid "The filename contains a path or path-traversal sequence."
msgstr "Ім'я файлу містить шлях або послідовність обходу шляху."

#: inc/class-image-validator.php:820
msgid "Hidden files and multiple extensions are not allowed."
msgstr "Приховані файли та кілька розширень не дозволені."

#: inc/class-image-validator.php:825
msgid "The filename has an empty or reserved basename."
msgstr "Ім'я файлу має порожню або зарезервовану основу."

#: inc/class-image-validator.php:903
msgid "The file contains a suspicious executable or script signature."
msgstr "Файл містить підозрілу сигнатуру виконуваного коду або скрипту."

#: inc/class-image-validator.php:911
msgid "The JPEG SOI/EOI structure is incomplete."
msgstr "Структура SOI/EOI файлу JPEG неповна."

#: inc/class-image-validator.php:922
msgid "The image container is unsupported."
msgstr "Контейнер зображення не підтримується."

#: inc/class-image-validator.php:936
msgid "The PNG chunk structure is invalid."
msgstr "Структура блоків PNG некоректна."

#: inc/class-image-validator.php:942
msgid "A PNG chunk CRC check failed."
msgstr "Перевірка CRC блоку PNG не пройдена."

#: inc/class-image-validator.php:955
msgid "The PNG does not end cleanly at the IEND chunk."
msgstr "PNG не завершується коректно на блоці IEND."

#: inc/class-image-validator.php:958
msgid "Animated PNG files are not allowed for product images."
msgstr "Анімовані PNG не дозволені для зображень товарів."

#: inc/class-image-validator.php:968
msgid "The WebP container is too short."
msgstr "Контейнер WebP занадто короткий."

#: inc/class-image-validator.php:972
msgid "The WebP RIFF size does not match the file size."
msgstr "Розмір RIFF у WebP не відповідає розміру файлу."

#: inc/class-image-validator.php:981
msgid "The WebP chunk structure is invalid."
msgstr "Структура блоків WebP некоректна."

#: inc/class-image-validator.php:995
msgid "The WebP container has trailing or incomplete data."
msgstr "Контейнер WebP містить зайві або неповні дані."

#: inc/class-image-validator.php:998
msgid "Animated WebP files are not allowed for product images."
msgstr "Анімовані WebP не дозволені для зображень товарів."

#: inc/class-image-validator.php:1023
msgid "The server image decoder could not fully decode the file."
msgstr "Серверний декодер не зміг повністю декодувати файл."

#: inc/class-image-validator.php:1031
msgid "Decoded image dimensions differ from the header dimensions."
msgstr ""
"Розміри декодованого зображення відрізняються від розмірів у заголовку."

#: inc/class-image-validator.php:1040
msgid "The image decoder reported a warning in strict mode."
msgstr "Декодер зображення повернув попередження в суворому режимі."

#: inc/class-image-validator.php:1044
msgid "The image decoder reported a non-blocking warning."
msgstr "Декодер зображення повернув неблокувальне попередження."

#: inc/class-image-validator.php:1090
msgid "The image appears almost uniform or has very low contrast."
msgstr "Зображення виглядає майже одноколірним або має дуже низький контраст."

#: inc/class-image-validator.php:1092
msgid "The image appears to have low contrast."
msgstr "Схоже, зображення має низький контраст."

#: inc/class-image-validator.php:1095
msgid "The image appears to be almost completely transparent."
msgstr "Схоже, зображення майже повністю прозоре."

#: inc/class-image-validator.php:1110
msgid "The image contains an ICC profile. Verify storefront color rendering."
msgstr ""
"Зображення містить профіль ICC. Перевірте відтворення кольорів на вітрині."

#: inc/class-image-validator.php:1118
msgid "The JPEG uses EXIF orientation and may require explicit autorotation."
msgstr ""
"JPEG використовує орієнтацію EXIF і може потребувати явного автоповороту."

#: inc/class-image-validator.php:1121
msgid "The JPEG contains GPS metadata."
msgstr "JPEG містить метадані GPS."

#: inc/class-image-validator.php:1124
msgid "The JPEG contains EXIF metadata. Metadata is not stripped in version 1."
msgstr "JPEG містить метадані EXIF. У версії 1 метадані не видаляються."

#: inc/class-image-validator.php:1234
msgid ""
"Gallery positions contain gaps. Version 1 will not renumber them "
"automatically."
msgstr ""
"Позиції галереї мають пропуски. Версія 1 не перенумеровує їх автоматично."

#: inc/class-media-uploader.php:29
msgid "The approved row is missing internal upload data."
msgstr "У схваленому рядку відсутні внутрішні дані завантаження."

#: inc/class-media-uploader.php:33
msgid "The resumable attachment no longer matches the canonical filename."
msgstr ""
"Вкладення для відновлення більше не відповідає канонічному імені файлу."

#: inc/class-media-uploader.php:36
msgid "The canonical filename appeared in WordPress after the dry run."
msgstr "Канонічне ім'я файлу з'явилося у WordPress після перевірки."

#: inc/class-media-uploader.php:42
msgid "Another upload is currently using the same canonical filename."
msgstr "Інше завантаження зараз використовує таке саме канонічне ім'я."

#: inc/class-media-uploader.php:68
msgid "A physical upload file already uses the canonical filename."
msgstr "Фізичний файл у каталозі завантажень уже має це канонічне ім'я."

#: inc/class-media-uploader.php:73
msgid "The canonical server copy could not be created."
msgstr "Не вдалося створити серверну копію з канонічним ім'ям."

#: inc/class-media-uploader.php:247 inc/class-media-uploader.php:264
msgid "The attachment parent could not be synchronized with the product."
msgstr "Не вдалося синхронізувати батьківський запис медіафайлу з товаром."

#: inc/class-media-uploader.php:255
msgid ""
"The attachment already belongs to another WordPress post, so its media "
"parent was not changed."
msgstr ""
"Медіафайл уже належить іншому запису WordPress, тому його батьківський запис "
"не змінено."

#: inc/class-media-uploader.php:281
msgid "WordPress did not create a valid attachment post."
msgstr "WordPress не створив коректний запис вкладення."

#: inc/class-media-uploader.php:287
msgid "The attachment MIME differs from the validated image MIME."
msgstr "MIME вкладення відрізняється від перевіреного MIME зображення."

#: inc/class-media-uploader.php:296
msgid ""
"The attachment file key does not contain the expected canonical filename."
msgstr "Ключ файлу вкладення не містить очікуваного канонічного імені."

#: inc/class-media-uploader.php:302
msgid "WordPress attachment metadata was not generated."
msgstr "Метадані вкладення WordPress не були створені."

#: inc/class-media-uploader.php:308
msgid ""
"Attachment metadata dimensions differ from the validated source dimensions."
msgstr ""
"Розміри в метаданих вкладення відрізняються від перевірених розмірів джерела."

#: inc/class-media-uploader.php:318
msgid "The attachment URL is missing or invalid."
msgstr "URL вкладення відсутній або некоректний."

#: inc/class-media-uploader.php:323
msgid "WordPress generated no derivative image sizes for this attachment."
msgstr "WordPress не створив похідних розмірів зображення для цього вкладення."

#: inc/class-media-uploader.php:333
msgid "The WooCommerce product disappeared before image assignment."
msgstr "Товар WooCommerce зник до призначення зображення."

#: inc/class-media-uploader.php:356
msgid "The image role is unsupported."
msgstr "Роль зображення не підтримується."

#: inc/class-media-uploader.php:374
msgid ""
"Remote-object verification was not required for the resolved attachment URL."
msgstr ""
"Для отриманого URL вкладення перевірка віддаленого об'єкта не була потрібна."

#: inc/class-media-uploader.php:423
msgid ""
"Remote HEAD metadata was incomplete, but the public object signature was "
"verified."
msgstr ""
"Віддалені метадані HEAD були неповними, але сигнатуру публічного об'єкта "
"перевірено."

#: inc/class-media-uploader.php:433
msgid ""
"The Media Cloud or OVH object could not be verified after bounded retries."
msgstr ""
"Не вдалося перевірити об'єкт Media Cloud або OVH після обмеженої кількості "
"спроб."

#: inc/class-plugin.php:53 inc/class-plugin.php:54
msgid "Product image batches"
msgstr "Пакети зображень товарів"

#: inc/class-plugin.php:89
msgid "Checking the batch…"
