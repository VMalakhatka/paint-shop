# Copy to .local.env, keep permissions 600, and never commit the real file.
FISCAL_MANAGER_USERNAME=manager
FISCAL_MANAGER_PASSWORD_HASH='pbkdf2_sha256$REPLACE_WITH_GENERATED_HASH'

FISCAL_HOST=127.0.0.1
FISCAL_PORT=8765
FISCAL_SECURE_COOKIE=false
FISCAL_DATABASE_PATH=runtime/fiscalization.sqlite3

# Safe experiment defaults.
FISCAL_FOLIO_SOURCE=mock
FISCAL_CHECKBOX_MODE=mock
FISCAL_CHECKBOX_NETWORK_ENABLED=false
FISCAL_MOCK_CHECKBOX_OUTCOME=success

# Future read-only Java/Folio adapter.
# FISCAL_FOLIO_SOURCE=http
# FISCAL_FOLIO_API_BASE_URL=https://java-api.example.invalid
# FISCAL_FOLIO_API_TOKEN=

# Optional real cashier authentication. Receipt creation remains absent in v0.1.
# FISCAL_CHECKBOX_MODE=api
# FISCAL_CHECKBOX_NETWORK_ENABLED=true
# FISCAL_CHECKBOX_LICENSE_KEY=
# FISCAL_CHECKBOX_ACCESS_KEY=
